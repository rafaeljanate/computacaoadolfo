var nomes = []
var notas = []
var media: real
var soma_das_medias: real = 0
var media_da_turma: real
var quantidade_de_alunos: inteiro = 0

enquanto (quantidade_de_alunos <= 0) {
    quantidade_de_alunos = inteiro(leia("Digite a quantidade de estudantes (superior a 0):"))
}

para (var i = 1; i <= quantidade_de_alunos; i = i + 1) {
    escreva("--- Registro do Aluno ${i} ---")
    var nome: texto = leia("Digite o nome do(a) estudante:")
    media = real(leia("Digite a média do(a) estudante:"))

    nomes.adicionar(nome)
    notas.adicionar(media)
    soma_das_medias = soma_das_medias + media
}

media_da_turma = soma_das_medias / quantidade_de_alunos
var limite_90: real = media_da_turma * 0.90

escreva("\nA média geral da turma foi: ${media_da_turma}")
escreva("Alunos com média superior a 90% da média da turma (nota > ${limite_90}):")

para (var i = 0; i < quantidade_de_alunos; i = i + 1) {
    se (notas[i] > limite_90) {
        escreva("- ${nomes[i]} (Nota: ${notas[i]})")
    }
}
